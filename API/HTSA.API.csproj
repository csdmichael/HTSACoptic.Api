<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CP.API</AssemblyName>
    <PackageId>HTSA.API</PackageId>
    <Authors>Michael Yaacoub</Authors>
    <Company>Michael Yaacoub</Company>
    <Product>HTSA</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\CarController.cs" />
    <Compile Remove="Controllers\LessonController.cs" />
    <Compile Remove="Controllers\PrivacyController.cs" />
    <Compile Remove="Controllers\SSClassController.cs" />
    <Compile Remove="Controllers\TokenInfoController.cs" />
    <Compile Remove="Repositories\CarRepository.cs" />
    <Compile Remove="Repositories\Interfaces\ICarRepository.cs" />
    <Compile Remove="Repositories\Interfaces\IKidRepository.cs" />
    <Compile Remove="Repositories\Interfaces\ILessonRepository.cs" />
    <Compile Remove="Repositories\Interfaces\IPrivacyRepository.cs" />
    <Compile Remove="Repositories\Interfaces\ISSClassRepository.cs" />
    <Compile Remove="Repositories\KidRepository.cs" />
    <Compile Remove="Repositories\LessonRepository.cs" />
    <Compile Remove="Repositories\PrivacyRepoitory.cs" />
    <Compile Remove="Repositories\SSClassRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="web.config" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="web.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.0.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.3500" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3500" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.0.3" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="3.6.0" />
    <PackageReference Include="SendGrid" Version="9.29.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Azure.Storage.Files.Shares" Version="12.17.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HTSA.DAL\HTSA.DAL.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\TokenAuth\TokenAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="credentials.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="login\failures\placeholder.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="RSAParams">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="token.json\Google.Apis.Auth.OAuth2.Responses.TokenResponse-user">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
